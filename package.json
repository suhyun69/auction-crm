{
  "name": "auction-crm",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "docker compose down -v --remove-orphans && docker compose up -d --wait db",
    "db:down": "docker compose down -v --remove-orphans",
    "simulate": "node simulator/cli.mjs",
    "simulate:demo": "node simulator/cli.mjs --dry-run --speed 10",
    "test:simulator": "node --test simulator/tests/*.test.mjs"
  }
}
