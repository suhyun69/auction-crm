  "devDependencies": {
    "@mikro-orm/cli": "^7.2.11",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "graphql-ws": "^6.4.3",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
