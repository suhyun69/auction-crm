    "@mikro-orm/migrations": "^7.2.11",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.11",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/mercurius": "^14.2.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "graphql": "^16.15.0",
    "mercurius": "^16.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
